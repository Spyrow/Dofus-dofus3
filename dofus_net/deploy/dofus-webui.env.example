# /etc/dofus-webui.env  (chmod 600, owner root) -- never commit the real file
DOFUS_ADMIN_USER=admin
# generated on your PC or the server:  python3 /opt/dofus_net/client/webui/auth.py hash
DOFUS_ADMIN_PASSWORD_HASH=pbkdf2$600000$...$...
DOFUS_SESSION_SECRET=replace-with-64-random-hex-chars
DOFUS_PUBLIC_HOST=bot.example.com
DOFUS_NET_DATA=/var/lib/dofus_net
